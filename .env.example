# Slack App tokens (required)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Anthropic API key (required for Claude Code CLI)
ANTHROPIC_API_KEY=sk-ant-your-key

# Redis URL (optional, uses in-memory store if not set)
# REDIS_URL=redis://localhost:6379

# Executor type: "process" (bare metal) or "docker"
EXECUTOR=process

# Maximum concurrent Claude sessions
MAX_CONCURRENT_SESSIONS=1

# Rate limiting
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=60000

# Admin channel for auth expiry notifications
# ADMIN_CHANNEL=C0123456789
